      "clip": true,
      "width": 560,
      "fill": "$bg",
      "layout": "vertical",
      "gap": 16,
      "padding": 28,
      "children": [
        {
          "type": "text",
          "id": "c0144",
          "name": "标题",
          "fill": "$text",
          "content": "新建字段",
          "fontFamily": "Noto Sans SC",
          "fontSize": 18,
          "fontWeight": "700"
        },
        {
          "type": "text",
          "id": "c0145",
          "name": "页面说明",
          "fill": "$muted",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "名称，以及一行文字、单选、多选。选了单选或多选时，下面列出可增删的选项。示例是多选字段「场合」。",
          "fontFamily": "Noto Sans SC",
          "fontSize": 13,
          "fontWeight": "normal"
