  "fixed_sql": [
    {
      "name": "clothing_items",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"clothing_items\" (\"id\" TEXT NOT NULL, \"category_id\" TEXT NOT NULL, \"image_path\" TEXT NULL, \"type\" TEXT NOT NULL DEFAULT '', \"product_name\" TEXT NOT NULL DEFAULT '', \"size_code\" TEXT NOT NULL DEFAULT '', \"style\" TEXT NOT NULL DEFAULT '', \"care_json\" TEXT NOT NULL DEFAULT '', \"color\" TEXT NOT NULL DEFAULT '', \"season\" TEXT NOT NULL DEFAULT '', \"fabric\" TEXT NOT NULL DEFAULT '', \"brand\" TEXT NOT NULL DEFAULT '', \"price\" REAL NULL, \"measurements\" TEXT NOT NULL DEFAULT '{}', \"purchased_at\" INTEGER NULL, \"purchase_info\" TEXT NOT NULL DEFAULT '', \"location\" TEXT NOT NULL DEFAULT '', \"tags\" TEXT NOT NULL DEFAULT '', \"note\" TEXT NOT NULL DEFAULT '', \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "outfits",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"outfits\" (\"id\" TEXT NOT NULL, \"category_id\" TEXT NOT NULL, \"image_path\" TEXT NULL, \"source_image_path\" TEXT NULL, \"cover_mode\" TEXT NOT NULL DEFAULT 'photo', \"collage_layout\" TEXT NULL, \"name\" TEXT NOT NULL DEFAULT '', \"season\" TEXT NOT NULL DEFAULT '', \"note\" TEXT NOT NULL DEFAULT '', \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "category_covers",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"category_covers\" (\"kind\" TEXT NOT NULL, \"category_id\" TEXT NOT NULL, \"cover_item_id\" TEXT NULL, PRIMARY KEY (\"kind\", \"category_id\"));"
        }
      ]
    },
    {
      "name": "categories",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"categories\" (\"id\" TEXT NOT NULL, \"kind\" TEXT NOT NULL, \"parent_id\" TEXT NULL, \"label\" TEXT NOT NULL, \"sort_order\" INTEGER NOT NULL, \"size_fields\" TEXT NOT NULL DEFAULT '[]', \"is_system\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_system\" IN (0, 1)), PRIMARY KEY (\"kind\", \"id\"));"
        }
      ]
    },
    {
      "name": "clothing_item_images",
      "sql": [
